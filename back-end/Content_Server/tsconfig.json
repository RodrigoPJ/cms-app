{
   "compilerOptions": {
      "lib": [
         "es2021"
      ],
      "target": "es2021",
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "rootDir": "./src",
      "outDir": "./build",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": true,
      "esModuleInterop":true,
      "noUnusedParameters": true,
      "noUnusedLocals": true,
   }
}