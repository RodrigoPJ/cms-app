Table user {
  id uuid [pk, ref: < project_item.accountId]
  userName varchar [unique]
  fullName varchar
  dateCreated timestamp
  userType varchar
}

Table project_item {
  id uuid [pk , ref: < project_content.projectItemId]
  accountId uuid
  contentType varchar
  name varchar
  isActive boolean
}

Table project_content {
  id uuid [pk]
  type varchar
  title varchar
  body varchar
  properties jsonb
  projectItemId uuid
}
