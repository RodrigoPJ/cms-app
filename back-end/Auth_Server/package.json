{
  "name": "back-end",
  "version": "1.0.0",
  "description": "Small Authentication server for home use",
  "main": "server.ts",
  "scripts": {
    "dev": "NODE_ENV=devlocal NODE_EXTRA_CA_CERTS=\"/Users/rodrigopena/Documents/cms-app/back-end/Auth_Server/certificates/rootCA.pem\" nodemon --exec ts-node ./src/server.ts",
    "build": "tsc --project tsconfig.json",
    "build:dev": "NODE_ENV=dev npm run build",
    "build:devlocal": "NODE_ENV=devlocal npm run build",
    "build:prod": "NODE_ENV=production npm run build",
    "start:dev": "NODE_ENV=dev node ./dist/server.js",
    "start:prod": "NODE_ENV=production node ./dist/server.js",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate ./src/migrations/default -d ./src/db-config/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs -d ./src/db-config/data-source.ts migration:run",
    "typeorm": "typeorm-ts-node-commonjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.828.0",
    "@aws-sdk/s3-request-presigner": "^3.828.0",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.3.3",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.24"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.21",
    "@types/node-forge": "^1.3.14",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
